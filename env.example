# ============================================================================
# TelePulse v6.5 — Environment Configuration (.env)
# Copy this file to `.env` and fill in your credentials.
# NEVER commit your real `.env` file to Git!
# ============================================================================

# Required: Telegram Bot Token from @BotFather & your numeric Telegram Chat ID
NOTIFY_BOT_TOKEN=YOUR_BOTFATHER_TOKEN_HERE
MAIN_ACCOUNT_CHAT_ID=YOUR_NUMERIC_CHAT_ID_HERE

# Optional: Operation Mode (1 = Zero-Login Public Web Scraper, 0 = Telethon Client)
USE_WEB_SCRAPER_FALLBACK=1
ONLY_NEW_MESSAGES_FROM_NOW=1

# Optional: Parallel Micro-Batching & Anti-Ban Pacing
TG_PARALLEL_BATCH=3
TG_BATCH_INTERVAL_SEC=5.0
TG_AUTOSTART=0

# Optional: Local Proxy Override (auto-detects 127.0.0.1:10808, 10809, 2080, 7890 by default)
# TG_PROXY=http://127.0.0.1:10808

# Optional: Storage & Logging Paths
TG_DB_PATH=telepulse.db
TG_LOG_FILE=telepulse.log
